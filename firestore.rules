rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened helper primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: Transaction (in 69319100016DB)
    function isValidTransaction(data) {
      return data.keys().hasAll([
          'userId', 'type', 'amount', 'category', 'title', 'note',
          'date', 'monthKey', 'paymentMethod', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'type', 'amount', 'category', 'title', 'note',
          'date', 'monthKey', 'paymentMethod', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid
        && data.type is string && data.type in ['income', 'expense']
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 100000000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.note is string && data.note.size() <= 500
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.date[0:7] == data.monthKey
        && data.paymentMethod is string && data.paymentMethod in ['cash', 'bank_transfer', 'promptpay', 'credit_card', 'e_wallet']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: MonthlyBudget
    function isValidMonthlyBudget(data) {
      return data.keys().hasAll(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
        && data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && (data.limitAmount is int || data.limitAmount is float) && data.limitAmount >= 0 && data.limitAmount <= 100000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Isolated PII user profile
    match /users/{userId}/private/profile {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    // Primary financial ledger collection: 69319100016DB
    match /69319100016DB/{transactionId} {
      allow get: if isSignedIn()
        && isValidId(transactionId)
        && existing().userId == request.auth.uid;

      allow list: if isSignedIn()
        && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'type', 'amount', 'category', 'title', 'note',
          'date', 'monthKey', 'paymentMethod', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(transactionId)
        && existing().userId == request.auth.uid;
    }

    // Monthly budget targets per user and month
    match /monthlyBudgets/{budgetId} {
      allow get: if isSignedIn()
        && isValidId(budgetId)
        && existing().userId == request.auth.uid;

      allow list: if isSignedIn()
        && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(budgetId)
        && isValidMonthlyBudget(incoming())
        && budgetId == (request.auth.uid + '_' + incoming().monthKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(budgetId)
        && isValidMonthlyBudget(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().monthKey == existing().monthKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['limitAmount', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(budgetId)
        && existing().userId == request.auth.uid;
    }
  }
}
